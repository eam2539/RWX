<configuration>
    <property name="LOG_DIR" value="${rwx.log.dir:-logs}"/>
    <property name="ROOT_LEVEL" value="${rwx.log.level:-INFO}"/>
    <property name="CONSOLE_LEVEL" value="${rwx.log.consoleLevel:-INFO}"/>
    <property name="THIRD_PARTY_LEVEL" value="${rwx.log.thirdPartyLevel:-WARN}"/>
    <property name="MAX_HISTORY" value="${rwx.log.maxHistory:-7}"/>
    <property name="MAX_FILE_SIZE" value="${rwx.log.maxFileSize:-20MB}"/>
    <property name="TOTAL_SIZE_CAP" value="${rwx.log.totalSizeCap:-200MB}"/>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{48} - %msg%n%ex"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${CONSOLE_LEVEL}</level>
        </filter>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/rwx.log</file>
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archive/rwx-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>2048</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="FILE"/>
    </appender>

    <logger name="io.github.rwx" level="${ROOT_LEVEL}"/>
    <logger name="com.corrodinggames" level="${ROOT_LEVEL}"/>
    <logger name="de.fabmax.kool" level="${THIRD_PARTY_LEVEL}"/>
    <logger name="io.netty" level="${THIRD_PARTY_LEVEL}"/>
    <logger name="org.apache" level="${THIRD_PARTY_LEVEL}"/>
    <logger name="org.bouncycastle" level="${THIRD_PARTY_LEVEL}"/>
    <logger name="org.koin" level="${THIRD_PARTY_LEVEL}"/>
    <logger name="org.lwjgl" level="${THIRD_PARTY_LEVEL}"/>

    <root level="${ROOT_LEVEL}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_FILE"/>
    </root>
</configuration>
