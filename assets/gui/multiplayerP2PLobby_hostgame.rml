<div>
  <div class="panelCloseButton" onclick="closePopup()" click_on_escape=""/>
  <p id="message2" class="smallmessage">Create a P2P room discovered over libp2p GossipSub. Game traffic uses WebRTC DataChannel with STUN/TURN NAT traversal.</p>
  <div class="checkboxDiv">
    <input type="checkbox" id="useMods"><label for="useMods" class="styledText smallmessage">Use active mods (joining players will require the same mods)</label></input>
  </div>
  <div class="inputDiv" style="padding-left:20px;">
    <label for="password" class="styledText smallmessage">Require Password:</label><input type="text" id="password" style="width: 7em;" />
  </div>
  <div class="mainButtons">
    <button id="button_cancel" onclick="closePopup();">Cancel</button>
    <button id="button_private" onclick="hostP2PStartFromPopup();">Host P2P</button>
  </div>
</div>
