<rml>
	<head>
		<title>Settings</title>
		<link type="text/rcss" href="rkt.rcss"/>
		<link type="text/rcss" href="common.rcss"/>
		<link type="text/rcss" href="forms.rcss"/>
		<style>
			
			body
	    {
		    /*width: 680px;*/
		    
		    width: 80%;
		    height: 525px;
		    /*height: 100%;*/
		    
		    
		    font-size: 25;
		    
		    
		    height: 80%;
		    top:5%;
		    
		  }
			
			
			.background
      {
        /*background:rgba(205,205,205,150);*/
        
        
        
        
        
        background:rgba(205,205,205,0);
        
        /*padding:13px;
        padding-right:40px;
        */
        
        
        /*background:rgba(205,0,205,120);*/
        
        height: 100%;
        
      }
      
      
		  h2
	    {
	      font-size: 35;
        font-weight:bold;
        
        text-align:center;
        
        display:block;
	    }
	    
	    h2.needsUnicodeFont
      {
        font-size: 27;
      }
      
      h3
      {
        font-size: 30;
	      color:black;
	      font-weight:bold;
	      
	      header-font-effect: shadow;
	      
	      header-width: 2px;
	      
        header-offset: 2px 2px;
        header-color: gray;
        
        display:block;
        
        border-bottom: 3px rgba(0,0,0,128);
        
        padding-left:0.6em;
        
        margin-bottom:0.5em;
        margin-top:0.5em;
        
        background:rgba(0,100,0,128);
        
      }
      
      h3.needsUnicodeFont
      {
        font-size: 27;
      }
			
			.group
			{
			  padding-left:0.5em;
			  
			}
			
			
			div
			{
			  /*border-style: solid;
	      border-width: 1px;
	      border-color: red;*/
			}
			
			
			.form
			{
			  text-align: left;
			  display: block;
			  
			  text-color:black;
			}
			
		  
		  
			label
			{
			  padding-bottom:0em;
			  margin-top:0em;
			  
			  /*border-style: solid;
			  border-width: 2px;
			  border-color: green;*/
			  
			  /*display:inline-block;*/
			  
        /*vertical-align:middle; */
        
			}
			
			#scrollDivWrap
      {
        
        height: 100%;
        
        position: relative;
			  
        /*background:rgba(0,220,0,120);*/
        
      }
       
      #scrollDiv
      {
        
        display:block;
			  /*display:inline-block;*/
			  
			  overflow-y: auto;
			  
			  
			  
			  /*min-height:230px;
			  
			  
			  max-height:540px;
			  
			  max-height:90%;*/
			  
			  /*height:100%;*/
			  
			  /*float:left;*/
			  
			  /*height: 100%;*/
			  
			  position: absolute;
			  top:0px;
			  bottom:30px;
			  left:0px;
			  right:0px;
			  
			  /*background:rgba(205,0,0,120);*/
			  
			  /*height:100%;*/
			  
			  /*width:100%;*/
			  
			  
			  /*
			  border-style: solid;
			  border-width: 2px;
			  border-color: red;
			  */
			  
			  margin: 3px;
			  padding: 3px;
			  
			  /*margin-bottom:-30em;*/
			  /*margin-bottom:20em;*/
      }
      
      .mainButtons
      {
        position: absolute;
			  bottom:0px;
      }
      
      
      .sliderDiv input
      {
        width:15em;
      }
      
      
      .sliderDiv label
      {
        width:10em;
			  
			  text-align:right;
      }
      
      
      .audioGroup .sliderDiv label
      {
        width:10em;
			  
			  text-align:right;
			  
			  
      }
      


      .mainButtons button
	    {
	      margin:6px;
	    }
      
      .whiteText label, .whiteText h2, .whiteText h3
      {
        color:white;
        header-color: black;
      }
      
      .selectDivMouse label
      {
        width:6.5em;
      }
      
      .selectDivMouse .boxButtonWrap
      {
        margin:10px;
        float:left;
        width:300px;
        
        
      }
      
      .hide
			{
			  display:none; /* not sure if needed */
			}
			
      .editKeybindingsWrap
      {
        padding-top:10px;
      }
      
      .editKeybindings
      {
        padding:7px 13px;
      }
      
		</style>
	</head>
	<body onshow="setPageMinWidthAndHeight(900, 800); loadSettings();" onunload="closeSettings();" onmouseup="updateRenderScaleInSettings(true)" id="body">
		
		
		<div class="background panelMainNoAlpha whiteText">
		  
		    <div class="panelCloseButton" onclick="back()" />
		    
		    
		    <div id="scrollDivWrap">
		    
		    <div id="scrollDiv">
		      
		      <h2>Settings</h2>
	        <form class="form">
	          
	          
	          <h3>${i:menus.settings.heading.graphics}</h3>
	          <div class="group audioGroup">
	            
	            
	            
	            
	            
	            <!-- hideClass( not( or( isLinux(), isMobile() ))  ) -->
	            
	            <div _class="${hideIfMobile()}" >
	              
	              <div _class="${hideIf( isLinux() ) }" >
	                <div class="checkboxDiv" >
	                  <!-- Fullscreen with dual screen doesn't work well on linux right now, borderless windowed is better anyway -->
	                  
	                  <input type="checkbox" name="slick2dFullScreen" data-settings id="slick2dFullScreen"><label for="fullscreen">Fullscreen</label></input>
	                  
	                  
	                </div>
	                
	                
	                <!--
	                <div class="selectDiv">
	                <label>Fullscreen Resolution:</label>
	                <select name="slick2dFullScreenResolution" data-settings id="slick2dFullScreenResolution">
	                  <option value="1280x720" >1280x800</option>
	                  <option value="1280x800" >1280x800</option>
	                  <option value="1440×900"  >1440x900</option>
	                  <option value="1680×1050" >1680x1050</option>
	                  <option value="1920x1080" selected >1920x1080</option>
	                  <option value="native" >Native</option>
                  </select>
	                </div>
	                -->
	              </div>
	              
	              
	              <div _class="${hideIf( isMac() ) }" >
	                <div class="checkboxDiv">
	                  <input type="checkbox" name="slick2dBorderless" data-settings id="slick2dBorderless"><label for="slick2dBorderless">Borderless-fullscreen (experimental)</label></input>
	                </div>
	              </div>
	              
	              
	              <div _class="${hideUnless( isLinux() )}" >
	                <p>Use F11 or your window manager equivalent to fullscreen on linux</p>
	              </div>
	              
	              <p>Note: Game can be resized to any resolution when windowed</p>
	              
	            </div>
	            
	            <div class="hide" >
	              <!-- Causes issues with shaders right now -->
	              <div class="sliderDiv">
	                <label>UI scaling: (<span id="uiRenderScaleDisplay">x0.0</span>)</label><input data-settings id="uiRenderScale" type="range" min="0.5" max="2.0" value="1" step="0.1" onchange="updateRenderScaleInSettings(false)"  /> 
	              </div>
	            </div>
	            
	            
	            <div class="sliderDiv">
	              <label>UI scaling: (<span id="renderDensityDisplay">x0.0</span>)</label><input data-settings id="renderDensity" type="range" min="0.5" max="2.5" value="1" step="0.1" onchange="updateRenderScaleInSettings(false)"  /> 
	            </div>
	            
	            
	            
	            <div class="checkboxDiv">
	              <input type="checkbox" data-settings id="showUnitWaypoints"><label for="showUnitWaypoints">${i:menus.settings.option.showUnitWaypoints}</label></input>
	            </div>
	            
	            <div class="checkboxDiv">
	              <input type="checkbox" data-settings id="showHp"><label for="showHp">${i:menus.settings.option.alwayUnitHealth}</label></input>
	            </div>
	            
	            
	            <div class="checkboxDiv">
	              <input type="checkbox" data-settings id="showUnitIcons"><label for="showUnitIcons">${i:menus.settings.option.unitIcons}</label></input>
	            </div>
	            
	            
	            <div _class="${hideIfMobile()}" >
	              <div class="checkboxDiv">
	                <input type="checkbox" data-settings id="renderVsync"><label for="renderVsync">${i:menus.settings.option.renderVsync}</label></input>
	              </div>
	            </div>
	            
	            <!--
	            <div class="checkboxDiv">
	              <input type="checkbox" data-settings id="renderDoubleScale"><label for="renderDoubleScale">${i:menus.settings.option.halfResolution}</label></input>
	            </div>
	            -->
	            
	            
	            
	            <div class="checkboxDiv">
	              <input type="checkbox" data-settings id="renderClouds"><label for="renderClouds">${i:menus.settings.option.renderClouds}</label></input>
	            </div>
	            
	            
	            
	            <div class="checkboxDiv">
	              <input type="checkbox" data-settings id="shaderEffects"><label for="shaderEffects">${i:menus.settings.option.shaderEffectsPC}</label></input>
	            </div>
	            
	            <div class="checkboxDiv">
	              <input type="checkbox" data-settings id="teamShaders"><label for="teamShaders">${i:menus.settings.option.teamShadersPC}</label></input>
	            </div>
	            
	            
	          </div>
	          <h3>Input</h3> <!----- Input ----->
	          <div class="group inputGroup">
	            
	            <div _class="${hideIfMobile()}" >
	              <div class="checkboxDiv">
	                <input type="checkbox" data-settings id="enableMouseCapture"><label for="enableMouseCapture">${i:menus.settings.option.enableMouseCapture}</label></input>
	              </div>
	            </div>
	            
	            <div class="checkboxDiv">
	              <input type="checkbox" data-settings id="quickRally"><label for="quickRally">${i:menus.settings.option.quickRally}</label></input>
	            </div>
	            
	            <div class="checkboxDiv">
	              <input type="checkbox" data-settings id="doubleClickToAttackMove"><label for="doubleClickToAttackMove">${i:menus.settings.option.doubleClickToAttackMove}</label></input>
	            </div>
	            
	            <div _class="${hideUnless( isMobile() ) }" >
	              <div class="checkboxDiv">
	                <input type="checkbox" data-settings id="showZoomButton"><label for="showZoomButton">${i:menus.settings.option.zoomButton}</label></input>
	              </div>
	            </div>
	            
	            <div _class="${hideIfMobile()}" >
	              
	              
	              <div class="selectDiv wide selectDivMouse">
	                <label>Keyboard Hotkeys:</label>
	                <div class="boxButtonWrap editKeybindingsWrap">
	                  <button class="boxButton center editKeybindings" onclick="open('settingsKeyBinding.rml')" ><span>Edit Keybindings</span></button>
	                </div>
	              </div>
	            
	            
	              <div class="selectDiv wide selectDivMouse">
	                <label>Mouse Orders:</label>
	                <select id="mouseOrders" data-settings>
	                  <option value="0"  >Auto (Ignore Left vs Right)</option>
	                  <option value="1"  >Left-Selection / Right-Action</option>
	                  <option value="2"  >Left-Action / Right-Selection</option>
                  </select>
	              </div>
	              
	              <div class="selectDiv wide selectDivMouse">
	                <label>Mouse Building:</label>
	                <select id="mousePlacement" data-settings>
	                  <option value="1"  >Left-Apply / Right-Cancel</option>
	                  <option value="2"  >Left-Cancel / Right-Apply</option>
                  </select>
	              </div>
	            
	            </div>
	            
	            <div class="sliderDiv">
	            <label>${i:menus.settings.option.scrollSpeed}</label><input data-settings id="scrollSpeed" type="range" min="0.2" max="4" value=".7" step="0.05" />
	            </div>
	            
	            <div _class="${hideIfMobile()}" >
	              <div class="sliderDiv">
	              <label>Edge scroll</label><input data-settings id="edgeScrollSpeed" type="range" min="0" max="4" value=".7" step="0.05" />
	              </div>
	            </div>
	            
	            
	          </div>
	          <h3>${i:menus.settings.heading.gameplay}</h3> <!----- Gameplay ----->
	          <div class="group gameplayGroup">
	            
	            
	            <div class="selectDiv bigger">
	            <label>${i:menus.settings.option.aiDifficulty}</label>
	            <select id="aiDifficulty" data-settings>
	              <option value="-2">${i:menus.settings.option.ai.-2}</option>
	              <option value="-1">${i:menus.settings.option.ai.-1}</option>
	              <option value="0" selected>${i:menus.settings.option.ai.0}</option>
	              <option value="1"  >${i:menus.settings.option.ai.1}</option>
	              <option value="2"  >${i:menus.settings.option.ai.2}</option>
	              <option value="3"  >${i:menus.settings.option.ai.3}</option>
              </select>
	            </div>
	            
	            
	            
	            
	            <div class="checkboxDiv">
	              <input type="checkbox" data-settings id="showSelectedUnitsList"><label for="showSelectedUnitsList">${i:menus.settings.option.showSelectedUnitsList}</label></input>
	            </div>
	            
	            <div class="checkboxDiv">
	              <input type="checkbox" data-settings id="useMinimapAllyColors"><label for="useMinimapAllyColors">${i:menus.settings.option.useMinimapAllyColors}</label></input>
	            </div>
	            
	            
	            <div class="checkboxDiv">
	              <input type="checkbox" data-settings id="showWarLogOnScreen"><label for="showWarLogOnScreen">${i:menus.settings.option.showWarLogOnScreen}</label></input>
	            </div>
	            
	            <div class="checkboxDiv">
	              <input type="checkbox" data-settings id="smartSelection_v2"><label for="smartSelection_v2">${i:menus.settings.option.smartSelection}</label></input>
	            </div>
	            
	            
	            <div _class="${hideUnless( isMobile() ) }" >
	              <div class="checkboxDiv">
	                <input type="checkbox" data-settings id="autosaving"><label for="autosaving">${i:menus.settings.option.autoSaveEnabled}</label></input>
	              </div>
	            </div>
	            
	            
	            <div class="selectDiv">
	            <label>${i:menus.settings.option.teamUnitCapSinglePlayer}:</label>
	            <select id="teamUnitCapSinglePlayer" data-settings>
	              <option value="100">100</option>
	              <option value="250">250</option>
	              <option value="500" >500</option>
	              <option value="1000" selected >1000</option>
	              <option value="2000"  >2000</option>
	              <option value="5000"  >5000</option>
	              <option value="10000" >10000</option>
              </select>
	            </div>
	            
	            <div class="selectDiv">
	            <label>${i:menus.settings.option.teamUnitCapHostedGame}:</label>
	            <select id="teamUnitCapHostedGame" data-settings>
	              <option value="100">100</option>
	              <option value="250" selected>250</option>
	              <option value="500" >500</option>
	              <option value="1000"  >1000</option>
	              <option value="2000"  >2000</option>
	              <option value="5000"  >5000</option>
	              <option value="10000" >10000</option>
              </select>
	            </div>
	            
	            <!--
	            <div class="selectDiv wide selectDivMouse">
	              <div class="boxButtonWrap">
	                <button class="boxButton center" onclick="" ><span>Workshop units (WIP)</span></button>
	              </div>
	            </div>
	            -->
	            
	          </div>
	          <h3>${i:menus.settings.heading.audio}</h3> <!----- Audio ----->
	          <div class="group audioGroup">
	            
	            <!--
	            <div class="checkboxDiv">
	              <input type="checkbox" name="enableSounds" data-settings id="enableSounds"><label for="enableSounds">${i:menus.settings.option.enableGameSounds}</label></input>
	            </div>
	            -->
	            
	            
	            <div class="sliderDiv">
	            <label>${i:menus.settings.option.masterVolume}</label><input data-settings id="masterVolume" type="range" min="0" max="1" value="1" step="0.01" />
	            </div>
	            
	            <div class="sliderDiv">
	            <label>${i:menus.settings.option.gameVolume}</label><input data-settings id="gameVolume" type="range" min="0" max="1" value="1" step="0.01" />
	            </div>
	            
	            <div class="sliderDiv">
	            <label>${i:menus.settings.option.interfaceVolume}</label><input data-settings id="interfaceVolume" type="range" min="0" max="1" value="1" step="0.01" />
	            </div>
	            
	            <div class="sliderDiv">
	            <label>${i:menus.settings.option.musicVolume}</label><input data-settings id="musicVolume" type="range" min="0" max="1" value="1" step="0.01" />
	            </div>
	            
	            
	            
              
	            <div class="selectDiv wide selectDivMouse">
	              <label></label>
	              <div class="boxButtonWrap">
                  <button class="boxButton center" onclick="playNextMusicTrack()" ><span>Next Music Track</span></button>
                </div>
	            </div>
	          
	          </div>
            <h3>${i:menus.settings.heading.replays}</h3>
            <div class="group">
	            
	            <div class="checkboxDiv">
	              <input type="checkbox" data-settings id="saveMultiplayerReplays"><label for="saveMultiplayerReplays">${i:menus.settings.option.saveReplays}</label></input>
	            </div>
	            
	            <div class="checkboxDiv">
	              <input type="checkbox" data-settings id="replaysShowRecordedChat"><label for="replaysShowRecordedChat">${i:menus.settings.option.replaysShowRecordedChat}</label></input>
	            </div>
	            
	          </div>
	          <h3>Misc</h3>
	          <div class="group">
	            
	            
	            <div class="checkboxDiv">
	              <input type="checkbox" data-settings id="forceEnglish"><label for="forceEnglish">${i:menus.settings.option.forceEnglish}</label></input>
	            </div>
	            
	            
	            <div _class="${hideUnless( isMobile() ) }" >
	              
	              <div class="boxButtonWrap">
                  <button class="boxButton center" onclick="importFilePopup()" ><span>Import file (save/replay/map/rwmod)</span></button>
                </div>
                
              </div>
              
                      
            </div>
            <h3>${i:menus.settings.heading.developer}</h3>
            <div class="group">
            
            
	            <div class="checkboxDiv">
	              <input type="checkbox" data-settings id="showFps"><label for="showFps">${i:menus.settings.option.showFps}</label></input>
	            </div>
	            
	            <div class="checkboxDiv">
	              <input type="checkbox" data-settings id="sendReports"><label for="sendReports">${i:menus.settings.option.sendReports}</label></input>
	            </div>
            
              <div class="checkboxDiv" _class="${hideUnless(hasReloadSupport())}">
	              <input type="checkbox" data-settings id="liveReloading"><label for="liveReloading">Live Resource Reloading - For GUI, images, unit data (in sandbox). </label></input>
	            </div>
            
            
              <div _class="${hideUnless( isMobile() ) }" >
                <div class="selectDiv wide selectDivMouse">
	                <label>Game log:</label>
	                <div class="boxButtonWrap">
	                  <button class="boxButton center" onclick="open('debugGameLog.rml')" ><span>View game log</span></button>
	                </div>
	              </div>
	            </div>
            
            </div>
            <h3>${i:menus.settings.heading.networking}</h3>
            <div class="group">
              
              <div class="inputDiv">
	              <label for="networkPort">Port Number (default=5123):</label><input type="text" id="networkPort" data-settings style="width: 5em;" />
	            </div>
              
	            <div class="checkboxDiv">
	              <input type="checkbox" data-settings id="udpInMultiplayer"><label for="udpInMultiplayer">${i:menus.settings.option.udpInMultiplayer}</label></input>
	            </div>
	            
	            <div class="checkboxDiv">
	              <input type="checkbox" data-settings id="showChatAndPingShortcuts"><label for="showChatAndPingShortcuts">${i:menus.settings.option.showChatAndPingShortcuts}</label></input>
	            </div>
	            
	            
	            <div class="checkboxDiv">
	              <input type="checkbox" data-settings id="showMapPingsOnBattlefield"><label for="showMapPingsOnBattlefield">${i:menus.settings.option.showMapPingsOnBattlefield}</label></input>
	            </div>
	            
	            <div class="checkboxDiv">
	              <input type="checkbox" data-settings id="showMapPingsOnMinimap"><label for="showMapPingsOnMinimap">${i:menus.settings.option.showMapPingsOnMinimap}</label></input>
	            </div>
	            
	            <div class="checkboxDiv">
	              <input type="checkbox" data-settings id="showPlayerChatInGame"><label for="showPlayerChatInGame">${i:menus.settings.option.showPlayerChatInGame}</label></input>
	            </div>
	            
	            
	            
	            
	            
	            
	          
	        </div>
	          
	          
	        </form>
		      
		      <br/>
		      
	        
	      </div>
	      
	      
	      <div class="mainButtons panelBottomButtons">
	        <button onclick="back()">Back</button>
	        
	        <button onclick="saveSettings();back()" click_on_escape="">Save</button>
	        
	      </div> 
	      
		  </div><!-- scrollDivWrap -->
		  
		  
		</div>
		
		
	</body>
</rml>
