<html>
	<head>
		<title>P2P Multiplayer</title>
		<link rel="stylesheet" type="text/css" href="rkt.rcss"/>
		<link rel="stylesheet" type="text/css" href="common.rcss"/>
		<link type="text/rcss" href="forms.rcss"/>
		<style>
			body { width: 100%; height: 100%; }
			.mainButtons { margin: auto; }
			.formSection { float:left; width:8em; margin:2px; }
			.joinSection input, .joinSection p { font-size: 18; }
			.joinSection input { display:block; margin: 0 auto; text-align:center; }
			.topSection { width:34em; margin: 0 auto; }
			.serverList { font-size: 18; position: relative; top:0px; bottom:0px; padding-right:30px; padding-left:30px; }
			.serverRowHeader { font-weight:bold; background:rgba(200,200,200,98); }
			.serverRowData { background:rgba(100,100,100,58); }
			.serverRowData:hover { background:rgba(200,0,0,48); border-color:rgba(200,0,0,255); }
			.serverRow .cell { border-style: solid; border-width: 1px; border-color: gray; overflow-x: hidden; overflow-y: hidden; width:16.5%; height:1.25em; margin-right:-1px; display: inline-block; }
			.serverRow .cell.rPlayers { width:7.5%; }
			.serverRow .cell.rVersion, .serverRow .cell.rOpen { width:8.5%; }
			.serverRow .cell.rMap { width:41.5%; }
			.panelMain { top:10%; width:100%; padding:15px; position: relative; }
			.panelMainContent { position: relative; top:0px; bottom:90px; padding:2px; }
			.bottomButtons { position: absolute; bottom:10px; padding:6px; }
			#serverScrollDiv { display:block; overflow-y:auto; width:100%; height:62%; }
			#username, #p2pBootstrapPeers { text-align:center; font-size: 18; }
			.versionNumberHeader { display:block; position:absolute; top:0; right:0; text-align:right; font-size:14; }
		</style>
	</head>
	<body onshow="setPageMinWidthAndHeight(700, 900); onShowNewScreen(); mp.loadUsername(); loadP2PConfig(); refreshP2PServerList()">
		<div class="versionNumberHeader">${getVersionName()}</div>
		<div class="panelMain">
			<div class="panelCloseButton" onclick="open('mainMenu.rml')" click_on_escape="" />
			<div class="panelMainContent">
				<div class="mainButtons">
					<div class="centerDivOuter topSection">
						<div class="centerDiv textinputUnicodeWrap">
							<div class="nameSection">
								<input id="username" type="text" name="username" value="Unnamed" onblur="mp.getUsernameFromInterface();"/>
							</div>
							<div class="nameSection" style="width:26em; padding-top:6px;">
								<input id="p2pLibp2pPeers" type="text" name="libp2pPeers" value="" onblur="saveP2PConfig(); refreshP2PServerList();"/>
								<p style="font-size:12; text-align:center;">Libp2p bootstrap peers (optional): /ip4/.../tcp/.../p2p/...</p>
							</div>
							<div class="formSection joinSection">
								<button onclick="directJoinPopup()">Direct Join</button>
							</div>
							<div class="formSection hostSection">
								<button onclick="createAndShowPopup('multiplayerP2PLobby_hostgame.rml', null, 'Host P2P game');">Host P2P</button>
							</div>
							<div class="formSection">
								<button onclick="open('multiplayerLobby.rml')"><p>Classic MP</p></button>
							</div>
						</div>
					</div>
					<div class="clearDiv"></div>
					<div class="serverList">
						<div class="serverRow serverRowHeader">
							<div class="cell rState">State</div>
							<div class="cell rHost">Host</div>
							<div class="cell rPlayers">#</div>
							<div class="cell rMap">Map</div>
							<div class="cell rVersion">Version</div>
							<div class="cell rOpen">Open</div>
						</div>
						<div id="serverScrollDivWrap">
							<div id="serverScrollDiv" class="slider" onscroll="checkServerListScroll()">
								<div id="serverListData">
									<div class="serverRow serverRowData serverRowMessage">
										<div class="rMessage">...</div>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div id="serverRowTemplateHolder" style="display:none;">
						<div class="serverRow serverRowData realServerRow">
							<div class="cell rState"></div>
							<div class="cell rHost"></div>
							<div class="cell rPlayers"></div>
							<div class="cell rMap"></div>
							<div class="cell rVersion"></div>
							<div class="cell rOpen"></div>
						</div>
					</div>
				</div>
			</div>
			<div class="bottomButtons">
				<div class="mainButtons">
					<button id="refreshButton" onclick="refreshP2PServerList()">Refresh</button><br/>
					<button class="backButtonText" onclick="open('mainMenu.rml')" click_on_escape="">Back</button><br />
				</div>
			</div>
		</div>
	</body>
</html>
