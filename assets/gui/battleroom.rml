      <div _class="${hideIf( isMobile() ) }" >
        <div class="chatSendBox textinputUnicodeWrap">
          <input id="chatMessage" type="text" name="chatMessage" value="" onenter="sendChatMessage(getValueById('chatMessage')); setValueById('chatMessage','')" />
          < !--<button class="boxButton" onclick="sendChatMessage(getValueById('chatMessage')); setValueById('chatMessage','')">Send</button> - ->
        </div>
      </div>
      
      
    </div>
		-->
		
		
	</body>
</rml>
